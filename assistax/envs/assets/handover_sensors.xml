        <key name="init_right" qpos='0.6 0 0.265 1 0 0 0 0 -0.785 0 -2.356 0 1.571 0.785 0.02 0.02 0 0.785 0 -2.356 0 1.571 -0.785 0.02 0.02'/>
    </keyframe>
    -->

</mujoco>